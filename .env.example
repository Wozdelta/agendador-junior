# Agenda manual e interface: nenhuma variável obrigatória na Vercel.
# Opções abaixo só são usadas pelos recursos correspondentes. Não use VITE_ para segredos.
APP_URL=https://agendador-junior.vercel.app
WEB_ORIGIN=https://agendador-junior.vercel.app
PUBLIC_BASE_URL=https://agendador-junior.vercel.app
# OPCIONAL: persistência de conexões OAuth, rascunhos e estados no servidor.
# Não é necessário para a agenda manual. KV_REST_API_URL / KV_REST_API_TOKEN também aceitos.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_PREFIX=agendador-junior-prod
# OPCIONAL: somente para uploads de vídeos/capas ao servidor (store público).
BLOB_READ_WRITE_TOKEN=
# OPCIONAL: obrigatória apenas ao usar tokens OAuth persistidos. Preserve a chave anterior.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
TIMEZONE=America/Sao_Paulo
PUBLISH_TIME=12:00
MIN_LEAD_MINUTES=15
LATE_TOLERANCE_MINUTES=20
MAX_ATTEMPTS=6
WORKER_CONCURRENCY=2
TICK_BUDGET_SECONDS=240
TASK_LEASE_MINUTES=6
MAX_VIDEO_MB=1024
MAX_IMAGE_MB=8
# Google / YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://agendador-junior.vercel.app/api/oauth/youtube/callback
# Meta: Facebook e Instagram usam o mesmo callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://agendador-junior.vercel.app/api/oauth/facebook/callback
META_GRAPH_VERSION=v27.0
META_LOGIN_CONFIG_ID=
META_REELS_CUSTOM_COVER=false
META_ALLOW_DIRECT_PUBLISH_FALLBACK=false
IG_RESUMABLE_UPLOAD=false
IG_CONTAINER_LEAD_MINUTES=60
# TikTok: habilite somente com o escopo efetivamente aprovado
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://agendador-junior.vercel.app/api/oauth/tiktok/callback
TIKTOK_VIDEO_UPLOAD_APPROVED=false
TIKTOK_DIRECT_POST_APPROVED=false
TIKTOK_INBOX_LEAD_MINUTES=30
# Apenas desenvolvimento local: não configure VERCEL=1 manualmente
HOST=127.0.0.1
PORT=3001
DATA_DIR=data
WORKER_TICK_MS=5000
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
MEDIA_LINK_TTL_MINUTES=120
