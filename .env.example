# Obrigatórias (somente servidor; não use prefixo VITE_).
Login_ADM=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
APP_URL=https://agendador-junior.vercel.app
# Somente OAuth: preserve a chave antiga se já houver tokens criptografados.
# 32 bytes em base64; gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Somente integrações; deixe vazias se usar apenas a agenda manual.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://agendador-junior.vercel.app/api/oauth/youtube/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://agendador-junior.vercel.app/api/oauth/facebook/callback
META_GRAPH_VERSION=v27.0
META_LOGIN_CONFIG_ID=
META_REELS_CUSTOM_COVER=false
META_ALLOW_DIRECT_PUBLISH_FALLBACK=false
IG_RESUMABLE_UPLOAD=false
IG_CONTAINER_LEAD_MINUTES=60
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://agendador-junior.vercel.app/api/oauth/tiktok/callback
TIKTOK_VIDEO_UPLOAD_APPROVED=false
TIKTOK_DIRECT_POST_APPROVED=false
TIKTOK_INBOX_LEAD_MINUTES=30
# Opcionais; uploads devem respeitar também o limite do bucket (50 MB no setup.sql).
MAX_VIDEO_MB=50
MAX_IMAGE_MB=8
MIN_LEAD_MINUTES=15
LATE_TOLERANCE_MINUTES=20
MAX_ATTEMPTS=6
WORKER_CONCURRENCY=2
TICK_BUDGET_SECONDS=240
TASK_LEASE_MINUTES=6
# Apenas desenvolvimento. APP_URL/WEB_ORIGIN locais: http://localhost:5173.
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:5173
# Legado local: a Vercel não usa arquivos no PC.
DATA_DIR=data
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
PUBLIC_BASE_URL=
MEDIA_LINK_TTL_MINUTES=120
